---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { CONTACT } from '../content/site';
import { contactSchema } from '../lib/schema';

const { hero, intro, email, expect } = CONTACT;
---
<Base page="contact" schema={contactSchema}>
  <PageHero title={hero.title} sub={hero.sub} backdrop />

  <section class="surface-mist band" aria-labelledby="demo-title">
    <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h2 id="demo-title" class="t-h2">{intro.title}</h2>
        <p class="t-lede mt-5 max-w-[34rem]">{intro.body}</p>

        <a href={`mailto:${email.address}`} class="email-card bracket mt-12 block rounded-lg bg-night p-8 text-fog sm:p-10">
          <span class="grid size-12 place-items-center rounded-lg bg-blue text-white">
            <Icon name="mail" class="size-6" />
          </span>
          <h3 class="mt-8 font-display text-lg font-semibold !text-fog">{email.title}</h3>
          <p class="mt-1 break-words font-display text-[1.75rem] font-semibold leading-tight tracking-tight text-white sm:text-4xl">{email.address}</p>
          <p class="mt-4 text-[0.9375rem]">{email.hint}</p>
        </a>
      </div>

      <div class="lg:col-span-4 lg:col-start-9 lg:pt-3">
        <h3 class="t-h3">{expect.title}</h3>
        <ul class="mt-6">
          {expect.items.map((item) => (
            <li class="flex items-start gap-4 border-b border-night/12 py-4 text-lg text-night first:border-t">
              <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-blue text-white">
                <Icon name="check" class="size-4" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .email-card {
    --bracket-gap: 0.75rem;
    transition: background-color 200ms ease;
  }
  .email-card::before { --c: var(--color-blue) !important; transition: inset 200ms ease; }
  .email-card:hover { background: var(--color-raised); }
  .email-card:hover::before { inset: -0.375rem; }
</style>
