---
// Homepage hero: the scroll-scrubbed fly-through ("Make the Pest Visible").
//
//   section[data-hero]  → header glass/solid hook (Header.astro): solid once this tall
//                         track's bottom edge passes the header.
//   .ft-stage           → sticky 100svh stage: poster (first frame) → canvas.
//   .ft-chapter         → semantic HTML copy per chapter, faded in/out by the controller.
//
// Two modes, chosen before first paint by the inline script below:
//   live   (html.ft-live) → pinned canvas scrubbed by src/scripts/flythrough.
//   static (reduced motion, Save-Data, low-memory device, ?static, no JS) → the chapters stack
//          as normal page sections, each over a representative still. No frames are fetched.
import { BEATS, CHAPTERS, FRAMES_ENABLED, manifest, type Chapter, type ChapterId } from '../content/flythrough';
import { UI } from '../content/site';
import { frameUrl } from '../scripts/flythrough/frames';

const m = FRAMES_ENABLED ? manifest : null;

// Chapters in the order the flight reaches them.
const order: ChapterId[] = [];
for (const b of BEATS) if (b.chapter && !order.includes(b.chapter)) order.push(b.chapter);

const beatVh = (mobile: boolean) =>
  BEATS.reduce((s, b) => s + (mobile ? b.mobileVh ?? b.vh : b.vh) + (b.hold?.start ?? 0) + (b.hold?.end ?? 0), 0);

// Two balanced lines so the detection bracket can hug the headline.
const words = CHAPTERS.arrive.heading.split(' ');
const cut = Math.floor(words.length / 2);
const lines = [words.slice(0, cut).join(' '), words.slice(cut).join(' ')];
---
{m && (
  <script is:inline>
    (function () {
      var n = navigator, c = n.connection;
      var still = /[?&]static\b/.test(location.search) ||
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        (c && c.saveData) || (n.deviceMemory && n.deviceMemory < 2);
      if (!still) document.documentElement.classList.add('ft-live');
    })();
  </script>
)}

<section
  class="ft relative isolate bg-abyss"
  aria-labelledby="hero-title"
  data-hero
  data-flythrough
  style={`--ft-vh:${beatVh(false)};--ft-vh-m:${beatVh(true)}`}
>
  <div class="ft-stage" data-ft-stage>
    {m && (
      <>
        <picture>
          {m.portraitPoster && <source media="(max-width: 47.99rem)" srcset={m.portraitPoster} />}
          <img class="ft-poster" data-ft-poster src={m.poster} width={m.width} height={m.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
        <canvas class="ft-canvas" data-ft-canvas aria-hidden="true"></canvas>
      </>
    )}

    {order.map((id) => {
      const c: Chapter = CHAPTERS[id];
      return (
        <div
          class="ft-chapter"
          data-chapter={id}
          data-align={c.align}
          data-mobile-body={String(c.mobileBody)}
          style={m ? `--still:url(${frameUrl(m, c.still)});--still-p:url(${m.portraitPattern ? frameUrl({ ...m, pattern: m.portraitPattern }, c.still) : frameUrl(m, c.still)})` : undefined}
        >
          <div class="wrap ft-inner">
            <div class="ft-copy">
              {id === 'arrive' ? (
                <h1 id="hero-title" class="t-display text-white">
                  <span class="bracket hero-lock">{lines[0]}<br />{lines[1]}</span>
                </h1>
              ) : (
                <h2 class="t-h1 text-white">{c.heading}</h2>
              )}
              {c.body && <p class="ft-body mt-6 max-w-[35rem] text-fog lg:mt-8">{c.body}</p>}
              {(c.primary || c.secondary) && (
                <div class="mt-8 flex flex-wrap gap-3 lg:mt-10">
                  {c.primary && <a href={c.primary.href} class="btn btn-primary">{c.primary.label}</a>}
                  {c.secondary && <a href={c.secondary.href} class="btn btn-ghost ft-secondary">{c.secondary.label}</a>}
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })}

    {m && <a class="ft-skip btn btn-ghost" href="#solutions">{UI.skipTour}</a>}
    <div class="ft-progress" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { initFlythrough } from '../scripts/flythrough';
  const el = document.querySelector<HTMLElement>('[data-flythrough]');
  if (el) initFlythrough(el);
</script>

<style>
  /* ── Static mode (default; also the no-JS and reduced-motion view) ─────────── */
  .ft-chapter {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100svh;
    overflow: hidden;
  }
  .ft-chapter + .ft-chapter { min-height: 80svh; }
  /* Representative still per chapter. A CSS background (not an <img>) so live mode,
     where it is never applied, never downloads it. */
  :global(html:not(.ft-live)) .ft-chapter { background: var(--color-abyss) var(--still-p) 50% 50% / cover no-repeat; }
  @media (min-width: 48rem) {
    :global(html:not(.ft-live)) .ft-chapter { background-image: var(--still); }
  }
  .ft-chapter::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to top, var(--color-abyss) 30%, rgb(19 26 39 / 0.55) 60%, rgb(19 26 39 / 0.2));
  }
  .ft-inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: max(3.5rem, env(safe-area-inset-bottom));
  }
  .ft-copy { max-width: 46rem; }
  .ft-body { font-size: 1.0625rem; line-height: 1.6; text-shadow: 0 1px 12px rgb(19 26 39 / 0.8); }

  @media (min-width: 48rem) {
    .ft-chapter::before {
      background:
        linear-gradient(90deg, rgb(19 26 39 / 0.94) 0%, rgb(19 26 39 / 0.82) 42%, rgb(19 26 39 / 0.1) 74%),
        linear-gradient(to top, rgb(19 26 39 / 0.6), transparent 30%);
    }
    .ft-chapter[data-align='right']::before {
      background:
        linear-gradient(270deg, rgb(19 26 39 / 0.94) 0%, rgb(19 26 39 / 0.82) 42%, rgb(19 26 39 / 0.1) 74%),
        linear-gradient(to top, rgb(19 26 39 / 0.6), transparent 30%);
    }
    .ft-inner { justify-content: center; padding-bottom: 6rem; }
    .ft-chapter[data-align='right'] .ft-copy { margin-left: auto; max-width: 34rem; }
    .ft-body { font-size: 1.1875rem; }
  }
  @media (min-width: 64rem) { .ft-body { font-size: 1.3125rem; } }

  .ft-progress, .ft-skip { display: none; }

  /* ── Live mode: pinned stage, canvas, chapters stacked in the stage ────────── */
  :global(html.ft-live) .ft { height: calc((var(--ft-vh) + 1) * 100svh); }
  @media (max-width: 47.99rem) {
    :global(html.ft-live) .ft { height: calc((var(--ft-vh-m) + 1) * 100svh); }
  }
  :global(html.ft-live) .ft-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .ft-poster, .ft-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ft-poster { object-fit: cover; transition: opacity 300ms ease; }
  :global(html:not(.ft-live)) :is(.ft-poster, .ft-canvas) { display: none; }
  :global(.ft-stage.is-drawn) .ft-poster { opacity: 0; }
  :global(html.ft-live) .ft-chapter {
    position: absolute;
    inset: 0;
    min-height: 0;
    opacity: 0;
    will-change: opacity;
  }
  :global(html.ft-live) .ft-chapter:first-of-type { opacity: 1; }
  :global(html.ft-live) .ft-copy { transform: translateY(var(--ft-rise, 0)); }
  /* Phones: one short heading per chapter during the flight; body returns at the reveal. */
  @media (max-width: 47.99rem) {
    :global(html.ft-live) .ft-chapter[data-mobile-body='false'] .ft-body,
    :global(html.ft-live) .ft-chapter[data-chapter='arrive'] .ft-secondary { display: none; }
    :global(html.ft-live) .ft-chapter::before {
      background: linear-gradient(to top, rgb(19 26 39 / 0.9) 18%, rgb(19 26 39 / 0.4) 45%, transparent 65%),
        linear-gradient(to bottom, rgb(19 26 39 / 0.55), transparent 22%);
    }
  }
  :global(html.ft-live) .ft-skip {
    display: inline-flex;
    position: absolute;
    right: max(1.25rem, env(safe-area-inset-right));
    top: calc(var(--header-h) + env(safe-area-inset-top) + 1rem);
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    background: rgb(19 26 39 / 0.45);
    z-index: 2;
  }
  :global(html.ft-live) .ft-progress {
    display: block;
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(var(--ft-progress, 0));
    background: var(--color-glow);
    z-index: 2;
  }

  /* The one orchestrated moment: the detection bracket locks onto the headline on load. */
  .hero-lock {
    display: inline-block;
    white-space: nowrap;
    --bracket-gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .hero-lock::before {
    --l: clamp(1rem, 2vw, 1.75rem);
    animation: lock-on 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 350ms both;
  }
  @keyframes lock-on {
    0% { opacity: 0; transform: scale(1.14); }
    55% { opacity: 1; }
    70% { transform: scale(0.985); }
    100% { opacity: 1; transform: scale(1); }
  }
</style>
