---
import { Picture } from 'astro:assets';
import circuit from '../assets/brand/hero-circuit.png';

interface Props {
  title: string;
  sub?: string;
  /** Circuit backdrop (content.md §9: Home/Solution/About/Contact); otherwise the sensor grid. */
  backdrop?: boolean;
  compact?: boolean;
}
const { title, sub, backdrop = false, compact = false } = Astro.props;
---
<section class:list={['page-hero relative isolate overflow-clip bg-abyss', { compact }]} data-hero aria-labelledby="page-title">
  {backdrop ? (
    <Picture src={circuit} formats={['avif']} fallbackFormat="webp" widths={[768, 1280, 1910]} sizes="(min-width: 48rem) 110vw, 100vw" alt="" loading="eager" fetchpriority="high" class="page-hero-img" />
  ) : (
    <div class="page-hero-grid" aria-hidden="true"></div>
  )}
  <div class="page-hero-scrim" aria-hidden="true"></div>
  <div class="wrap relative">
    <h1 id="page-title" class="t-h1 max-w-[18ch] text-white">{title}</h1>
    {sub && <p class="t-lede mt-6 max-w-[40rem] text-fog">{sub}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-top: calc(var(--header-h) + 5rem);
    padding-bottom: 4.5rem;
  }
  @media (min-width: 64rem) {
    .page-hero { padding-top: calc(var(--header-h) + 8rem); padding-bottom: 7rem; min-height: 34rem; }
  }
  .page-hero.compact { padding-bottom: 3.5rem; min-height: 0; }
  @media (min-width: 64rem) { .page-hero.compact { padding-top: calc(var(--header-h) + 6rem); padding-bottom: 4.5rem; } }

  :global(.page-hero-img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    opacity: 0.55;
  }
  @media (min-width: 48rem) {
    :global(.page-hero-img) { left: 20%; width: 100%; opacity: 0.9; }
  }
  .page-hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(77 171 247 / 0.22) 1px, transparent 1.4px);
    background-size: 28px 28px;
    mask-image: linear-gradient(100deg, transparent 30%, #000 85%);
  }
  .page-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, var(--color-abyss) 5%, rgb(19 26 39 / 0.7) 45%, rgb(19 26 39 / 0.1) 80%),
      linear-gradient(to top, var(--color-abyss), transparent 35%);
  }
</style>
