---
import type { CtaLink } from '../content/flythrough';

interface Props {
  title: string;
  body: string;
  button: CtaLink;
}
const { title, body, button } = Astro.props;
---
<section class="cta relative isolate overflow-clip" aria-labelledby="cta-title">
  <div class="cta-grid" aria-hidden="true"></div>
  <div class="wrap grid gap-8 py-20 md:grid-cols-12 md:items-end lg:py-28">
    <h2 id="cta-title" class="t-h2 text-white md:col-span-7 lg:text-[3.5rem]">{title}</h2>
    <div class="md:col-span-5 lg:col-span-4 lg:col-start-9">
      <p class="text-lg leading-relaxed text-white/85">{body}</p>
      <a href={button.href} class="btn btn-light mt-8">{button.label}</a>
    </div>
  </div>
</section>

<style>
  .cta { background: linear-gradient(120deg, var(--color-blue) 0%, var(--color-blue-deep) 70%); }
  .cta-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 85% 20%, #000 10%, transparent 70%);
  }
</style>
